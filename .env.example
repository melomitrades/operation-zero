# Copiez ce fichier en .env.local et remplissez les valeurs

# Neon Database - récupérez cette URL dans votre dashboard Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Mot de passe professeur (hashé au premier lancement via /api/setup)
PROF_PASSWORD_HASH=""

# Secret pour les cookies de session (générez une chaîne aléatoire longue)
NEXTAUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"
